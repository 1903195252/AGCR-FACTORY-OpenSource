 // load model from binary MJB resource
 mjModel* mj_loadModel(const char* filename, const mjVFS* vfs) {
+  // Local file-only extension. VFS/custom resource-provider behavior and the
+  // public int-sized buffer ABI remain unchanged. Do not narrow the file size.
+  if (!vfs && filename) {
+    std::ifstream file(filename, std::ios::binary | std::ios::ate);
+    if (file && file.tellg() > INT_MAX) {
+      const std::streamoff size = file.tellg();
+      std::unique_ptr<char[]> bytes(new char[static_cast<size_t>(size)]);
+      file.seekg(0);
+      if (!file.read(bytes.get(), size)) {
+        mju_warning("Could not read complete large MJB file");
+        return nullptr;
+      }
+      return mj_loadModelBuffer64(bytes.get(), static_cast<mjtSize>(size));
+    }
+  }
   std::array<char, 1024> error;
 
   mjResource* resource = mju_openResource("", filename, vfs, error.data(), error.size());
